{
  "name": "learning-chinese",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && tsc --noEmit && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
