  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "pinyin-pro": "^3.27.0",
    "qrcode": "^1.5.4"
  }
}
